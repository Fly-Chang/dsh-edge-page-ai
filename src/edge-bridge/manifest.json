{
  "manifest_version": 3,
  "name": "DSH Page AI",
  "version": "0.1.1",
  "description": "dsh-edge-page-ai 浏览器薄壳：把页面桥接到本机 DSH 网关，只负责注入与转发，不保存模型密钥。",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "DSH 页面助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "bridge-client.bundle.mjs"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "commands": {
    "toggle-dsh-panel": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "显示/隐藏 DSH 页面助手面板"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
